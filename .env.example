# Copy to .env and adjust. Everything here has a sensible default.
# .env itself is gitignored; commit only this template.

# --- database ---
# Leave unset (or sqlite) for zero-config demo:
#   DATABASE_URL=
# Or point at a real postgres (see `python -m darkforce.setup_pg` or Docker compose):
#   DATABASE_URL=postgresql://darkforce:darkforce_dev@127.0.0.1:5433/darkforce

# --- auth (RBAC) ---
# Secret used to sign dashboard login tokens.
SECRET_KEY=change-me-to-a-long-random-string
# Default admin seeded on first run (only when users table is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- tor ---
# Docker compose: socks5h://tor:9050 ; local managed Tor spawns itself.
# TOR_EXTERNAL=socks5h://127.0.0.1:9050
# TOR_HOST=127.0.0.1
# TOR_PORT=9050

# --- telegram ingestion (optional, requires Telethon + an API id/hash) ---
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_NAME=darkforce
# TG_CHANNELS=@motherofmarkets,@anychannel